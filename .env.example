# GitHub token is optional for public PR reads; recommended for API rate limits.
GITHUB_TOKEN=

# Real review and the local demo need an LLM API key.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_actual_api_key

# If LLM_PROVIDER=gemini, configure GEMINI_API_KEY and a Gemini-compatible LLM_MODEL.
# GEMINI_API_KEY=your_actual_gemini_key
# LLM_MODEL=your_gemini_model